generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  amount      Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

model Client {
  id String @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  notes     String?
  userId    String
  createdAt DateTime  @default(now())
  riskScore Float?    @default(0)
  updatedAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id])
  Invoice   Invoice[]

  @@index([userId])
}

model Invoice {
   id String @id @default(cuid())
  clientId  String
  status    InvoiceStatus @default(DRAFT)
  dueDate   DateTime
  total     Decimal       @default(0)
  createdAt DateTime      @default(now())
  invoiceNo String        @unique
  userId    String
  subtotal  Float
  tax       Float?        @default(0)
  amount    Decimal       @db.Decimal(12, 2)
  currency  String?       @default("INR")
  notes     String?
  updatedAt DateTime      @default(now())
  Client    Client        @relation(fields: [clientId], references: [id])
  User      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     InvoiceItem[]
  Payment   Payment[]
  Reminder  Reminder[]

  @@index([clientId])
  @@index([status])
  @@index([userId])
}

model Notification {
  id        String   @id
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model Payment {
  id String @id @default(cuid())
  invoiceId String
  amount    Decimal
  paidAt    DateTime       @default(now())
  method    PaymentMethod? @default(BANK_TRANSFER)
  createdAt DateTime       @default(now())
  Invoice   Invoice        @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Reminder {
  id        String   @id
  invoiceId String
  sendAt    DateTime
  sent      Boolean  @default(false)
  Invoice   Invoice  @relation(fields: [invoiceId], references: [id])
}

model User {
id String @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(OWNER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  Client       Client[]
  Invoice      Invoice[]
  Notification Notification[]
}

enum Role {
  OWNER
  ADMIN
  STAFF
  USER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VIEWED
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  UPI
  CASH
  OTHER
}
