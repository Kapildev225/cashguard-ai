PORT=5000

# Copy a fresh connection string from Neon:
# Neon Dashboard -> Project -> Connection Details -> Node.js or Prisma.
# If you reset the Neon password, update this value immediately.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional. Use this only if Prisma asks for a shadow database during migrations.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/SHADOW_DATABASE?sslmode=require"
